# ==============================================================================
# RAD-ARES: Artemis & Interplanetary Radiation Dosimetry Engine Configuration
# ==============================================================================
# Environment Variables & Secrets Template
# Copy this file to '.env' and populate your API credentials.

# --- Core Server Configuration ---
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
API_PREFIX=/api/v1
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501","http://127.0.0.1:8501"]

# --- AI Core: Google AI Studio (Gemini Multi-Key High-Availability Pool) ---
GEMINI_API_KEY=your_primary_gemini_api_key_here
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_API_KEY_4=your_gemini_api_key_4_here
GEMINI_API_KEY_5=your_gemini_api_key_5_here
GEMINI_MODEL=gemini-2.5-flash

# --- NASA & Space Radiation Simulation Thresholds (NASA-STD-3001) ---
NASA_PEL_CAREER_MSV=250.0
NASA_LEGACY_CAREER_MSV=600.0
ARS_PRODROMAL_THRESHOLD_MSV=500.0
LUNAR_SURFACE_ANNUAL_DOSE_MSV=400.0
MARTIAN_SURFACE_ANNUAL_DOSE_MSV=270.0
